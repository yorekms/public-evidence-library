  "unit": "People per 100 members of the selected population aged 15 and older.",
  "population": "Women, men, and total use the corresponding published population and labor-force denominators. The total comes from the total-population rates.",
  "definitions": "The labor force consists of employed and unemployed persons. Unemployment generally requires being without employment, seeking work and available for work. People outside the labor force are in neither category.",
  "formula": {
    "p": "Published participation rate, percent of this population aged 15+.",
    "u": "Published unemployment rate, percent of this group’s labor force.",
    "impliedEmployed": "p × (1 − u / 100)",
    "unemployed": "p × u / 100",
    "outsideLaborForce": "100 − p"
  },
  "reportedEmployment": "The separately published employment-to-population ratio is provided as a source value alongside the implied employed share. Computing from published rates at their reported precision can give small differences.",
  "missingValues": "Blank means unavailable. Participation alone yields the outside share. Employed and unemployed shares require both participation and unemployment. All three complete calculated shares sum to 100 before display rounding.",
  "interpretation": "These are annual population shares. They describe the prevalence of each status within a year. The ILO combines nationally reported and imputed observations. The WDI extract provides no country-year imputation flag. The publisher cautions against rankings using imputed figures. National definitions and working-age thresholds can vary.",
  "references": [
    "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/SL.TLF.CACT.ZS",
    "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/SL.UEM.TOTL.ZS",
    "https://ilostat.ilo.org/resources/concepts-and-definitions/description-labour-force-statistics/"
  ]
