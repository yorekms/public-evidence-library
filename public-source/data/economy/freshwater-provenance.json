  "methodology": {
    "source": "FAO AQUASTAT, distributed in World Development Indicators. The water productivity indicator also uses World Bank and OECD GDP estimates.",
    "glossaries": {
      "water-per-person-renewable": "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/ER.H2O.INTR.PC",
      "water-pressure-internal": "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/ER.H2O.FWTL.ZS",
      "water-pressure-stress": "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/ER.H2O.FWST.ZS",
      "water-productivity": "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/ER.GDP.FWTL.M3.KD",
      "water-volume-renewable": "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/ER.H2O.INTR.K3",
      "water-volume-withdrawals": "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/ER.H2O.FWTL.K3",
      "water-withdrawal-agriculture": "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/ER.H2O.FWAG.ZS",
      "water-withdrawal-domestic": "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/ER.H2O.FWDM.ZS",
      "water-withdrawal-industry": "https://databank.worldbank.org/metadataglossary/world-development-indicators/series/ER.H2O.FWIN.ZS"
    },
    "resourceMethod": "https://www.fao.org/aquastat/en/overview/methodology/water-resources/index.html",
    "productivity": "GDP in constant 2015 US dollars divided by annual freshwater withdrawals. Sector mix and natural resource endowments affect comparisons.",
    "sectors": "Agricultural, industrial and domestic withdrawals are independently published as shares of all withdrawals. Some reported shares exceed 100 percent, and the three shares can differ from 100 percent in total. Gaps and original values are retained.",
    "pressure": "Water stress (SDG 6.4.2) divides freshwater abstraction by renewable resources including external inflows, after environmental flow requirements. Withdrawals relative to internal resources use domestically generated renewable flows. The withdrawal definitions also differ in their treatment of desalination. Values can exceed 100 percent on either measure.",
    "supply": "Internal resources are long-term average yearly river flows and groundwater recharge generated by domestic precipitation. Published averages can repeat across years. Per-person estimates use population in the given year. Withdrawals measure water taken from a source, including volumes that can later return.",
    "priorAtlas": "Five 2022 series also exist in the frozen atlas: agricultural, industrial and domestic shares, total withdrawals, and water stress. Each of the 887 snapshot values is present in its corresponding annual history."
  },
