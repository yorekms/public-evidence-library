{"series":{"id":"cost-of-living::median-monthly-gross-rent","label":"Median monthly gross rent","dataset_id":"frozen-atlas","unit":"2024 U.S. dollars per month","scope":"us_states","definition":"Published ACS B25064_E001 median gross rent. Gross rent is contract rent plus estimated average monthly tenant-paid utilities/fuels; B25064_M001 is the published 90% MOE.","denominator":"Renter-occupied housing units paying cash rent","reporting_period":"2024 ACS 1-year estimate","source_url":"https://www2.census.gov/programs-surveys/acs/summary_file/2024/table-based-SF/data/1YRData/acsdt1y2024-b25064.dat","sources":[{"id":"acs-gross-rent-2024","title":"U.S. Census · ACS 2024 B25064 median monthly gross rent","url":"https://www2.census.gov/programs-surveys/acs/summary_file/2024/table-based-SF/data/1YRData/acsdt1y2024-b25064.dat","date":"2024 ACS 1-year estimates; retrieved 2026-10-28","note":"Native state median gross rent for renter-occupied housing units paying cash rent, in 2024 dollars per month. Gross rent includes contract rent and estimated tenant-paid utilities/fuels. Published 90% MOEs preserved.","license":"U.S. federal government public information; source attribution retained."}],"limitations":["RPP compares state price levels within a given year. It is not a year-to-year inflation rate, a complete family living budget or a required-income estimate.","All-items U.S. RPP is 100, while published U.S. component rows are not all exactly 100. The original indexes and each actual national component reference are preserved without renormalization.","Housing-services RPP reflects rents, including how rental evidence supports the accounts; it is not a home-purchase-price index. ACS gross rent is monthly rent plus estimated tenant-paid utilities/fuels.","ACS B25071 directly publishes the median household rent-to-income percentage among relevant renter units. It is not calculated by dividing two unrelated state medians, and it is not the fraction of renters above a 30% burden threshold.","ACS rent and rent-burden MOEs define 90% confidence intervals. RPP rows do not include comparable sampling intervals here.","State price and rental summaries cannot identify an individual household’s affordability, needed spending or housing preferences."],"interval_type":"90% confidence interval from published ACS margin of error","display_reference":null,"years":[2024],"places":[{"id":"AL","name":"Alabama"},{"id":"AK","name":"Alaska"},{"id":"AZ","name":"Arizona"},{"id":"AR","name":"Arkansas"},{"id":"CA","name":"California"},{"id":"CO","name":"Colorado"},{"id":"CT","name":"Connecticut"},{"id":"DE","name":"Delaware"},{"id":"DC","name":"District of Columbia"},{"id":"FL","name":"Florida"},{"id":"GA","name":"Georgia"},{"id":"HI","name":"Hawaii"},{"id":"ID","name":"Idaho"},{"id":"IL","name":"Illinois"},{"id":"IN","name":"Indiana"},{"id":"IA","name":"Iowa"},{"id":"KS","name":"Kansas"},{"id":"KY","name":"Kentucky"},{"id":"LA","name":"Louisiana"},{"id":"ME","name":"Maine"},{"id":"MD","name":"Maryland"},{"id":"MA","name":"Massachusetts"},{"id":"MI","name":"Michigan"},{"id":"MN","name":"Minnesota"},{"id":"MS","name":"Mississippi"},{"id":"MO","name":"Missouri"},{"id":"MT","name":"Montana"},{"id":"NE","name":"Nebraska"},{"id":"NV","name":"Nevada"},{"id":"NH","name":"New Hampshire"},{"id":"NJ","name":"New Jersey"},{"id":"NM","name":"New Mexico"},{"id":"NY","name":"New York"},{"id":"NC","name":"North Carolina"},{"id":"ND","name":"North Dakota"},{"id":"OH","name":"Ohio"},{"id":"OK","name":"Oklahoma"},{"id":"OR","name":"Oregon"},{"id":"PA","name":"Pennsylvania"},{"id":"RI","name":"Rhode Island"},{"id":"SC","name":"South Carolina"},{"id":"SD","name":"South Dakota"},{"id":"TN","name":"Tennessee"},{"id":"TX","name":"Texas"},{"id":"UT","name":"Utah"},{"id":"VT","name":"Vermont"},{"id":"VA","name":"Virginia"},{"id":"WA","name":"Washington"},{"id":"WV","name":"West Virginia"},{"id":"WI","name":"Wisconsin"},{"id":"WY","name":"Wyoming"}],"rows":51,"numeric_rows":51,"hosted